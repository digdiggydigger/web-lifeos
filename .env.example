# Firebase Web App config (Firebase console → Project settings → Your apps → Web).
# Copy to .env.local (gitignored). These are client identifiers, not secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=adhdlifeos-acb49.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=adhdlifeos-acb49
VITE_FIREBASE_STORAGE_BUCKET=adhdlifeos-acb49.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# true → connect Auth/Firestore/Storage to the local Emulator Suite (ports in firebase.emulators.json)
VITE_USE_EMULATORS=false
