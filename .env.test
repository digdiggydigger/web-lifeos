# Loaded by Vite in `mode=test` (Vitest). A "demo-" project id keeps the emulators fully offline;
# every service is pointed at the local Emulator Suite (ports in firebase.emulators.json).
VITE_FIREBASE_API_KEY=emulator
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_PROJECT_ID=demo-adhdlifeos
VITE_FIREBASE_STORAGE_BUCKET=demo-adhdlifeos.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=0
VITE_FIREBASE_APP_ID=emulator
VITE_USE_EMULATORS=true
