{
  "hosting": [
    {
      "target": "web",
      "public": "dist",
      "ignore": ["firebase.json", "**/.*"],
      "rewrites": [
        {
          "source": "/api/daily-summary",
          "run": { "serviceId": "dailysummary", "region": "us-central1" }
        },
        { "source": "**", "destination": "/index.html" }
      ]
    }
  ]
}
